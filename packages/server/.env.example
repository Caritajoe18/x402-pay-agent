# Hedera testnet account (fund at portal.hedera.com/faucet)
HEDERA_ACCOUNT_ID=0.0.12345
HEDERA_PRIVATE_KEY=0x...

# x402 client identity (agent's signing key — defaults to HEDERA_ACCOUNT_ID if unset)
HEDERA_CLIENT_ID=
HEDERA_CLIENT_KEY=

# HCS audit trail topic (leave empty to auto-create on first run)
HCS_TOPIC_ID=

# x402 facilitator — Blocky402 (open, no API key required for testnet)
FACILITATOR_URL=https://api.testnet.blocky402.com

# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Server port
PORT=4021
